# Kopiér til .dev.vars (gitignored) til lokal udvikling.
# Appens adresse lokalt (Vite). Passkeys bindes til værtsnavnet, og mutationer skal komme herfra.
# Bruger du `npm run preview` (alt på :8787), så sæt den til http://localhost:8787.
APP_ORIGIN=http://localhost:5173
# Tillad MCP Inspector's localhost-callback (kun lokalt!).
OAUTH_ALLOW_LOCALHOST=true
