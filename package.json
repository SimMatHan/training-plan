{
  "name": "traeningsnav",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "plan:build": "tsx plan/seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply traeningsnav --local",
    "db:seed:local": "wrangler d1 execute traeningsnav --local --file plan/seed.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "exceljs": "^4.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
